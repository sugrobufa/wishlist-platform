// Схема по ARCHITECTURE §4 (v0.3) + модели Auth.js (adapter).
// Контракт модели вещи — design/package/handoff/items.json.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------- Пользователь и Auth.js ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String? // управляется Auth.js (OAuth-профиль)
  image         String? // управляется Auth.js
  displayName   String? // продуктовое имя в комнате
  avatarKey     String? // S3
  locale        String    @default("ru")
  secondAuth    Json? // «укрепление» перед первым шером: { provider, sub }
  // Когда просили укрепить аккаунт (тикет 94). Просим РОВНО ОДИН раз, перед
  // первым шером: «терять ещё нечего — значит и привязывать незачем» (доска
  // Б8). Отказ — тоже ответ, и он тоже пишется сюда: повторная просьба
  // превратилась бы в уговоры.
  hardenAskedAt DateTime?
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  room         Room?
  connectionsA Connection[] @relation("ConnA")
  connectionsB Connection[] @relation("ConnB")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Комната ----------

/**
 * Кто вообще входит в сокровищницу (ADR-0011, тикет 116). Про ЭКРАН витрины,
 * а не про цену на ней: `PriceVisibility` рядом остаётся своим и отвечает на
 * другой вопрос.
 *
 * ПОЧЕМУ ТРИ, А НЕ ЧЕТЫРЕ. Дизайн просил четыре по образцу цены, но у ЭКРАНА
 * «только мне» и «никому» — одно и то же событие: гостю входа нет. Четвёртое
 * положение было бы двумя словами для одной двери.
 *
 * ПОЧЕМУ ОТДЕЛЬНЫЙ ENUM. Общий тип с `PriceVisibility` означал бы, что
 * настройки можно перепутать местами; наборы значений у них разные.
 */
enum HallVisibility {
  ALL
  MUTUAL
  NONE
}

model Room {
  id            String    @id @default(cuid())
  userId        String    @unique
  preset        String // 'cream' | 'warm' | ... из design/package/handoff/rooms.json
  zoneSet       String    @default("ALL") // 'F' | 'M' | 'ALL' — «набор зон»
  zonesOff      String[] // выключенные зоны исчезают вместе с мебелью
  // «Что чаще всего хочется» — ответ третьего шага онбординга (тикет 113,
  // доска 34b). Ключи зон, 3–4 штуки. НА КОМНАТУ НЕ ВЛИЯЕТ: полки не
  // переставляются и не выключаются (прямоугольники — инвариант, набор зон
  // решает шаг 2). Ответ красит только подборку «начни с готового» и порядок
  // зон в добавлении вещи. Пусто — вопрос пропустили, и это законно.
  wants         String[]
  shareSlug     String    @unique
  nick          String?   @unique // красивый ник /r/{nick} (гриллинг №3); null — не занят
  // ---- День рождения хозяйки (тикет 187, решение владельца 11.08.2026) ----
  // Здесь была ОДНА отметка `occasionDate DateTime?` — разовая дата «когда
  // праздник». Она протухала молча: прошла — и комната переставала напоминать,
  // а спросить снова было негде. Теперь хранится ДЕНЬ и МЕСЯЦ, а «ближайший
  // праздник» считается от сегодня (src/server/birthday.ts): прошёл — следующий
  // сам становится через год.
  // ГОД НЕОБЯЗАТЕЛЕН и никогда не показывается: возраст продукту не нужен ни
  // для чего. Он только хранится — если человек его назвал (или если он приехал
  // миграцией из прежней колонки), терять его незачем.
  // День без месяца (и наоборот) не бывает: пишет их одна `rooms.setBirthday`.
  birthdayDay   Int?
  birthdayMonth Int?
  birthdayYear  Int?
  demoGhostsOff Boolean   @default(false) // «Убрать примеры»: демо-призраки скопом выключены
  createdAt     DateTime  @default(now())

  // ---- Свет и время суток (тикет 96, доска Б6, турн 11e) ----
  // Две последние ручки персонализации: «если у всех одинаковая комната,
  // метафора умирает». Кадры при этом НЕ перегенерируются — это грейдинг-слой
  // поверх фотографии. Родные положения = «как снято», слоёв нет.
  // Хранится на комнате: гость видит свет, который выбрала хозяйка.
  // ПОЛОЖЕНИЙ ТРИ, А НЕ ЧЕТЫРЕ (тикет 133, миграция `night_is_dusk`): «ночь»
  // упразднена — она давала тот же кадр, что вечер, а два одинаковых положения
  // с разными именами это ложь интерфейсу. Существующим комнатам миграция
  // проставила `dusk`; чтение всё равно недоверчиво (`asTimeOfDay` переводит
  // случайно уцелевший `night` в `dusk`, а мусор — в родное `day`).
  timeOfDay  String @default("day") // morning | day | dusk
  lightColor String @default("warm") // warm | white | candle

  // ---- Сокровищница: кто вообще входит (тикет 116, ADR-0011) ----
  // Про ЭКРАН витрины, а не про цену на ней: соседняя настройка ниже отвечает
  // на другой вопрос, и смешивать их нельзя (ADR-0011 §«инварианты»).
  // Три положения, а не четыре: у экрана «только мне» и «никому» — одна и та
  // же дверь, и человек не отличил бы результат.
  // Дефолт ОТКРЫТЫЙ, в отличие от цены. Закрытый стоил бы слишком дорого:
  // холодный гость приходит по ссылке ДО праздника и связи ещё не имеет — при
  // дефолте «только взаимным» он не увидел бы витрину никогда, а у
  // существующих комнат поведение поменялось бы молча и в закрытую сторону.
  hallVisibility HallVisibility @default(ALL)

  // ---- Зал славы: стоимость подарков (тикет 35, ADR-0004, турн 12d) ----
  // Четыре положения, а не тумблер, — «стоимость это чувствительно»; дефолт
  // FRIENDS обязателен по ADR-0004 («только друзьям», не «всем»).
  hallPriceVisibility PriceVisibility @default(FRIENDS)
  // «18 вещей на 340 000 ₽» в шапке зала. Самостоятельный тумблер: одна цена
  // — про вещь, общая сумма — про человека (доска, турн 12d).
  hallTotalShown Boolean @default(true)
  // «Кто подарил» — имя дарителя под вещью в зале. Управляет ПОКАЗОМ, а не
  // повторным раскрытием: раскрытие бывает ровно один раз (инвариант №2).
  hallGiverShown Boolean @default(true)
  // «Округлять цены»: «около 60 000» вместо 62 000. Только показ — сумма зала
  // считается по точным значениям.
  hallRoundPrices Boolean @default(false)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  Item[]
  goal   RoomGoal?
  events RoomEvent[]
}

// ---------- Копилка на мечту (ADR-0008, тикет 44) ----------
//
// Хозяйка называет цель («на велосипед, 45 000 ₽»), гость говорит «я участвую».
// Деньги идут МИМО СЕРВИСА: он их не принимает, не хранит и не переводит
// (PRD §12а не меняется). Поэтому здесь нет ни платежа, ни статуса оплаты —
// только договорённость.
//
// ПОЧЕМУ ОТДЕЛЬНАЯ МОДЕЛЬ, А НЕ BookingMode.POOL. Складчина — режим брони
// ВЕЩИ: у неё есть Item, цена вещи, «Дошло» и переезд в зал славы. У копилки
// вещи нет вовсе (цель — не вещь: в зал славы не уезжает, в агрегаты зоны не
// входит), зато есть своя сумма и своя валюта. POOL остаётся Phase 2 и этой
// моделью не разблокируется.
model RoomGoal {
  id       String  @id @default(cuid())
  roomId   String  @unique // одна цель на комнату: «основной подарок» доски
  title    String // на что копит: «на велосипед»
  amount   Decimal @db.Decimal(12, 2) // Decimal, никогда float
  currency String // ISO 4217 отдельным полем, как у вещей

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room    Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  pledges GoalPledge[]
}

// «Я участвую». Имя хозяйке НЕ отдаётся до экрана «что подарили» (инвариант
// №2), сумма — не отдаётся ей никогда (следствие инварианта №1: прогресс сбора
// видят только гости).
model GoalPledge {
  id          String   @id @default(cuid())
  goalId      String
  guestName   String
  guestEmail  String?
  guestUserId String?
  // Обещанная сумма — необязательна: «я участвую» без суммы тоже участие.
  // Прогресс складывает названные суммы, участников считает всех.
  amount      Decimal? @db.Decimal(12, 2)
  currency    String
  cancelToken String   @unique
  createdAt   DateTime @default(now())

  goal RoomGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

// ---------- Вещь: одно тело, два МЕСТА (items.json v2, тикет 124) ----------
//
// Состояний у вещи больше нет. `ItemState` (LOVE | WANT) убран решением
// владельца 09.08.2026: «всё, что хочет хозяин, и есть его любовь». Различие
// переехало из ПОЛЯ в МЕСТО, и место у нас уже было названо:
//   `inHall = false` — КОМНАТА: чего хочется. Бронируется, цена по
//                      `priceVisibility`, степень желания `desire`;
//   `inHall = true`  — СОКРОВИЩНИЦА: что уже моё. Не бронируется, цена гостю
//                      не показывается вовсе.
// `zone` вещь держит В ОБОИХ местах — иначе «Вернуть в комнату» некуда
// возвращать (решение владельца 09.08).

enum PriceVisibility {
  ALL
  FRIENDS
  ME
  NONE
}

enum ItemSource {
  URL
  MANUAL
  PHOTO
  CATALOG
  SHARE
  EXTENSION
  BOT
}

model Item {
  id           String  @id @default(cuid())
  roomId       String
  zone         String // ключ зоны из zones.json — и в комнате, и в сокровищнице
  title        String
  note         String?
  photoKey     String? // техническое поле, на место вещи не влияет
  url          String?
  canonicalUrl String?
  domain       String?

  // ---- Вещь комнаты: цена, размеры, степень желания ----
  // Живут у всего, но показываются только пока вещь в комнате: в
  // сокровищнице цены нет вовсе (инвариант №8). Значения при переезде
  // СОХРАНЯЮТСЯ — «Вернуть в комнату» показывает цену снова.
  price           Decimal?        @db.Decimal(12, 2)
  currency        String?
  priceVisibility PriceVisibility @default(ALL)
  size            String?
  color           String?
  desire          Int? // «насколько хочется», 1–4

  // ---- Услуга-впечатление (тикет 97, доска Б20, турн 8e) ----
  // «Когда · Где · Годен до» вместо размера и цвета: у мастер-класса нет
  // размера, у сертификата есть срок. Все три необязательны — пустое поле
  // просто не рисуется. `when`/`where` — СТРОКИ, а не даты: доска просит
  // пускать «выходные», «март», «онлайн».
  eventWhen  String? // «14 марта», «выходные», «март»
  eventWhere String? // город, место или «онлайн»
  // Крайний срок актуальности: конец сертификата, последний день выставки.
  // Дата, а не строка: по ней вещь уходит из «можно подарить» наутро после.
  validUntil DateTime?

  // ---- Сокровищница: место вещи и история подарка ----
  // `inHall` — ЕДИНСТВЕННЫЙ признак места (тикет 124). Обратим: «Дошло»
  // уводит вещь на витрину, «Вернуть в комнату» приводит обратно в её `zone`.
  // Необратимо ДРУГОЕ — раскрытие имени дарителя (инвариант №2): `giverName`
  // проставляется ровно один раз, на экране «что подарили», и переезды его
  // не трогают.
  giverName      String?
  receivedAt     DateTime?
  inHall         Boolean   @default(false)
  hiddenFromHall Boolean   @default(false)

  hidden           Boolean    @default(false) // видит только хозяйка
  source           ItemSource @default(MANUAL)
  catalogProductId String?
  priceCheckedAt   DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  booking        Booking?
  priceSnapshots PriceSnapshot[]

  @@index([roomId, zone, inHall])
  @@index([canonicalUrl])
}

// ---------- Тихая бронь ----------

enum BookingMode {
  QUIET
  SIGNED
  POOL
}

model Booking {
  id          String      @id @default(cuid())
  itemId      String      @unique
  mode        BookingMode @default(QUIET)
  guestName   String // хозяйке НЕ отдаётся до «что подарили» (инвариант §5)
  guestEmail  String?
  guestUserId String?
  cancelToken String      @unique
  purchased   Boolean     @default(false)
  createdAt   DateTime    @default(now())

  // Гость предложил остаться на связи (тикет 98b, доска 32a). Вопрос задаётся
  // на подтверждении брони — до праздника и до всякой связи, поэтому живёт
  // здесь, а не в Connection: Connection к этому моменту ещё не существует.
  // Смысл — на ПАРЕ гость↔хозяйка, а не на вещи: вторая бронь той же хозяйке
  // вопроса не задаёт, предложение уже сделано. Всегда false у гостя без
  // аккаунта: связывать некого.
  offersConnection Boolean @default(false)

  item Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  pool PoolContribution[]
}

model PoolContribution {
  id        String    @id @default(cuid())
  bookingId String
  name      String
  amount    Decimal   @db.Decimal(12, 2)
  paidAt    DateTime? // оплата — Phase 2, провайдер по решению о рынке
  createdAt DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// «Что подарили»: итог праздника; имена раскрываются ровно один раз.
// (roomId, date) уникальна (полировка 16): гонка cron+клик не плодит два
// summary одной даты — проигравший ловит P2002 и берёт существующий
// (closeOccasion идемпотентен и под гонкой).
model OccasionSummary {
  id         String    @id @default(cuid())
  roomId     String
  date       DateTime
  revealedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([roomId, date])
}

// ---------- Лента «Что происходит» (тикет 114, доска 34c) ----------

enum RoomEventKind {
  ITEMS_ADDED // друг добавил вещи в комнату (склеивается за день на чтении)
  SHELF_OPENED // в зоне появилась первая вещь
  TREASURY_OPENED // открыл видимость сокровищницы
  ROOM_CHANGED // сменил интерьер
  BECAME_MUTUAL // согласие состоялось с обеих сторон
}

/**
 * Событие живой комнаты. Пять видов, и все — про КОМНАТУ, а не про подарки:
 * подарочный слой (брони, складчины, «что подарили») в ленту не попадает ни
 * в каком виде — это прямое следствие инварианта №1 и отдельное правило
 * доски 34c.
 *
 * ПОЧЕМУ ТАБЛИЦА, А НЕ ВЫЧИСЛЕНИЕ. Два события из пяти считались бы по датам
 * вещей, а три — нет: момента смены интерьера, открытия сокровищницы и
 * согласия не хранит никто. Событие — это факт «когда», и хранить его надо
 * тогда, когда оно случилось.
 *
 * `payload` — только то, что нужно СТРОКЕ: ключ зоны, имя пресета. Имён и
 * вещей здесь нет и быть не может.
 */
model RoomEvent {
  id        String        @id @default(cuid())
  roomId    String
  kind      RoomEventKind
  payload   Json?
  createdAt DateTime      @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

// ---------- Связи (не добавляются вручную) ----------

enum ConnectionKind {
  MUTUAL
  FOLLOW
  VIEWED
}

model Connection {
  id        String         @id @default(cuid())
  aUserId   String
  bUserId   String
  kind      ConnectionKind
  origin    String // 'gift:{itemId}' | 'visit' | 'pool:{bookingId}'
  history   Json?
  createdAt DateTime       @default(now())

  // Согласие обеих сторон остаться на связи (тикет 98, доска Б12). Вопрос
  // задаётся ТОЛЬКО у связи из подарка и ровно после праздника: момент —
  // consentAskedAt. null у него значит «не спрашивали» (связь из визита и
  // все строки до этого тикета) — такие связи ведут себя как раньше.
  // consentA/consentB: null — сторона ещё не ответила, false — «не в этот
  // раз». Согласие НЕ создаёт связь и не ищет людей (инвариант №4): оно
  // отвечает про уже существующую строку.
  consentAskedAt DateTime?
  consentA       Boolean?
  consentB       Boolean?
  // Когда связь СТАЛА взаимной (тикет 114): «Соня теперь в твоих связях» —
  // пятое событие ленты. Это событие СВЯЗИ, а не комнаты, поэтому и живёт
  // здесь, а не в RoomEvent: у него две стороны и ни одной комнаты.
  // null — взаимной ещё не становилась.
  mutualAt       DateTime?

  a User @relation("ConnA", fields: [aUserId], references: [id], onDelete: Cascade)
  b User @relation("ConnB", fields: [bUserId], references: [id], onDelete: Cascade)

  @@unique([aUserId, bUserId])
}

// ---------- Цены и парсинг ----------

model PriceSnapshot {
  id        String   @id @default(cuid())
  itemId    String
  price     Decimal  @db.Decimal(12, 2)
  currency  String
  available Boolean?
  checkedAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, checkedAt])
}

model ParseJob {
  id        String   @id @default(cuid())
  url       String
  userId    String
  status    String // PENDING | FAST_DONE | BROWSER_PENDING | DONE | FAILED
  result    Json?
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

// ---------- Каталог фидов (Phase 2–3, флаг CATALOG_ENABLED) ----------

enum CatalogSourceType {
  ADMITAD
  EPN
  YML
  AMAZON_PAAPI
  ALIEXPRESS
}

model CatalogSource {
  id         String            @id @default(cuid())
  type       CatalogSourceType
  name       String
  config     Json
  enabled    Boolean           @default(false)
  lastSyncAt DateTime?

  products CatalogProduct[]
}

model CatalogProduct {
  id           String                       @id @default(cuid())
  sourceId     String
  externalId   String
  title        String
  brand        String?
  zone         String // маппинг в нашу таксономию зон
  imageUrl     String
  price        Decimal                      @db.Decimal(12, 2)
  currency     String
  url          String
  affiliateUrl String?
  gtin         String?
  available    Boolean                      @default(true)
  raw          Json?
  updatedAt    DateTime                     @updatedAt
  embedding    Unsupported("vector(768)")?

  source CatalogSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalId])
  @@index([zone, available])
}

model OutboundClick {
  id               String   @id @default(cuid())
  catalogProductId String?
  itemId           String?
  context          String // SPACE | ZONE | LIST | RESERVE_PAGE
  subId            String?
  createdAt        DateTime @default(now())

  @@index([catalogProductId, createdAt])
}

// ---------- AI-распознавание (Phase 2, флаг RECOGNIZE_ENABLED) ----------

model RecognitionJob {
  id         String   @id @default(cuid())
  userId     String
  imageKey   String // приватный bucket
  status     String // PENDING | DONE | FAILED
  attrs      Json?
  candidates Json?
  error      String?
  createdAt  DateTime @default(now())
}
