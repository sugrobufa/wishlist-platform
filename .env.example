# --- База и очереди (docker compose up -d) ---
DATABASE_URL=postgresql://wishlist:wishlist@localhost:5432/wishlist
REDIS_URL=redis://localhost:6379

# --- S3 (dev: MinIO из docker-compose) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wishlist
S3_PRIVATE_BUCKET=wishlist-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CDN_BASE_URL=

# --- Auth.js ---
# Сгенерировать: npx auth secret (или любые 32+ случайных байта)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Google OAuth (опционально в dev; без него работает только magic link)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Apple / Telegram — «укрепление» аккаунта, Phase 1–2
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
TELEGRAM_BOT_TOKEN=

# --- Почта (пусто в dev → magic link печатается в консоль сервера) ---
EMAIL_SERVER=
EMAIL_FROM=room@wishlist.local

# --- Быстрый вход для ТЕСТОВОГО СТЕНДА (тикеты 29 и 31) ---
# Временный обход письма, пока к стенду не подключён SMTP. Штатный вход
# (почта → ссылка) работает всегда и остаётся основным.
# Выключено по умолчанию: без QUICK_LOGIN_ENABLED=true адрес /dev-login — 404.
# Включено: /dev-login пускает сразу (без ключа и формы), а /dev-login?fresh=1
# ещё и СТИРАЕТ комнату владельца целиком и ведёт на онбординг заново.
# На боевом стенде, когда появится почта, вернуть false и очистить секрет.
QUICK_LOGIN_ENABLED=false
# НЕОБЯЗАТЕЛЕН (тикет 31): пусто — вход открыт. Заполнен (24+ символа) —
# старая ссылка /dev-login?key=… тоже работает, неверный ключ → 404.
# Сгенерировать: openssl rand -hex 24
QUICK_LOGIN_SECRET=
# Единственная почта, которой разрешён быстрый вход и чью комнату стирает
# ?fresh=1 (почта владельца). Параметры запроса на неё не влияют.
QUICK_LOGIN_EMAIL=

# --- Приложение ---
APP_BASE_URL=http://localhost:3000
PARSER_UA="WishlistBot/1.0"

# --- AI (Phase 2) ---
ANTHROPIC_API_KEY=

# --- Фичефлаги ---
CATALOG_ENABLED=false
RECOGNIZE_ENABLED=false

# --- Партнёрские источники (по решению о рынке, Phase 2–3) ---
ADMITAD_TOKEN=
EPN_KEY=
AMAZON_PAAPI_KEY=

# --- Наблюдаемость (только prod) ---
SENTRY_DSN=
POSTHOG_KEY=
