# Образец боевого .env (тикет 28). На сервере лежит копия этого файла по
# пути /opt/wishlist/.env с ЗАПОЛНЕННЫМИ значениями.
#
#   cp .env.prod.example .env && nano .env && chmod 600 .env
#
# ЗДЕСЬ НЕТ И НЕ ДОЛЖНО БЫТЬ НАСТОЯЩИХ ПАРОЛЕЙ: файл лежит в репозитории.
# Настоящий .env в git не попадает (.gitignore) и никогда не уезжает в
# образ (.dockerignore) — он живёт только на сервере.
#
# Переменные читают сразу двое: docker compose (подставляет их в
# docker-compose.prod.yml) и само приложение внутри контейнера.

# ══ Образ ═══════════════════════════════════════════════════════════════
# Обе строки правит автоматика деплоя — руками трогать только при откате.
APP_IMAGE=ghcr.io/ВЛАДЕЛЕЦ/wishlist-platform
APP_TAG=latest

# ══ Домен и адреса ══════════════════════════════════════════════════════
# APP_DOMAIN — ОДНА точка переключения между «пока без домена» и «домен есть».
#
#   пока домена нет:  APP_DOMAIN=155-212-143-124.sslip.io
#     Имя вида «IP-через-дефисы.sslip.io» разворачивается в этот самый IP
#     без всякой регистрации, и Let's Encrypt выдаёт на него НАСТОЯЩИЙ
#     сертификат — HTTPS будет честным, с замком.
#   домен куплен:     APP_DOMAIN=example.ru
#     У регистратора (или в панели Beget) сделать A-запись example.ru →
#     155.212.143.124, здесь поменять три строки ниже и перезапустить.
#
# Только имя: без «https://», без порта, без косой черты в конце.
APP_DOMAIN=155-212-143-124.sslip.io

# Адрес приложения целиком — им подписываются ссылки в письмах.
# Меняется вместе с APP_DOMAIN.
APP_BASE_URL=https://155-212-143-124.sslip.io

# Почта для Let's Encrypt: туда придёт письмо, если сертификат перестанет
# продлеваться. ОБЯЗАТЕЛЬНА — с пустым значением прокси не стартует.
ACME_EMAIL=

# ══ Секрет входа ════════════════════════════════════════════════════════
# Подписывает сессии. Сгенерировать прямо на сервере и вставить сюда:
#   openssl rand -base64 32
# Менять нельзя без нужды: смена разлогинит всех разом.
AUTH_SECRET=

# Приложение стоит за прокси Caddy — Auth.js должен доверять заголовкам.
AUTH_TRUST_HOST=true

# ══ База данных ═════════════════════════════════════════════════════════
# Пароль придумывать не надо, сгенерируйте:  openssl rand -hex 24
# ОДНО И ТО ЖЕ значение подставьте и в POSTGRES_PASSWORD, и в DATABASE_URL.
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=
POSTGRES_DB=wishlist
# Хост «postgres» — имя контейнера внутри docker, не опечатка.
DATABASE_URL=postgresql://wishlist:ТОТ_ЖЕ_ПАРОЛЬ@postgres:5432/wishlist

# ══ Очереди ═════════════════════════════════════════════════════════════
# Redis наружу не выведен, живёт только внутри docker — пароль не нужен.
REDIS_URL=redis://redis:6379

# ══ Хранилище файлов (MinIO) ════════════════════════════════════════════
# Ключи — логин и пароль хранилища. Сгенерировать:
#   openssl rand -hex 8    → S3_ACCESS_KEY
#   openssl rand -hex 24   → S3_SECRET_KEY
S3_ACCESS_KEY=
S3_SECRET_KEY=

# S3_ENDPOINT — ПУБЛИЧНЫЙ адрес, тот же домен. Так и задумано: браузер
# загружает фото прямо в хранилище по подписанной ссылке, а значит адрес
# должен быть виден снаружи. Caddy пускает наружу только пути бакетов, и
# без подписи хранилище отвечает отказом. Меняется вместе с APP_DOMAIN.
S3_ENDPOINT=https://155-212-143-124.sslip.io
S3_BUCKET=wishlist
S3_PRIVATE_BUCKET=wishlist-private
# CDN перед картинками — пока нет; пусто.
CDN_BASE_URL=

# ══ Почта ═══════════════════════════════════════════════════════════════
# ПОКА ПУСТО — и это рабочее состояние, а не недоделка: без EMAIL_SERVER
# письма и ссылки для входа ПЕЧАТАЮТСЯ В ЛОГ приложения. Как их прочитать —
# docs/DEPLOY.md, раздел «Вход, пока нет почты».
#
# Когда домен оформлен и в панели Beget заведён ящик, заполнить обе строки:
#   EMAIL_SERVER=smtps://room@example.ru:ПАРОЛЬ_ЯЩИКА@smtp.beget.com:465
#   EMAIL_FROM=room@example.ru
# (собаку в пароле и логине писать как %40)
EMAIL_SERVER=
EMAIL_FROM=room@localhost

# ══ Прочее приложение ═══════════════════════════════════════════════════
PARSER_UA="WishlistBot/1.0"

# ══ Вход через соцсети (необязательно) ══════════════════════════════════
# Пусто — работает вход по ссылке из письма, этого достаточно.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
TELEGRAM_BOT_TOKEN=

# ══ Фичефлаги ═══════════════════════════════════════════════════════════
# Каталог и распознавание фото — вторая фаза, в бою выключены.
CATALOG_ENABLED=false
RECOGNIZE_ENABLED=false

# ══ Быстрый вход (тикеты 29 и 31) ═══════════════════════════════════════
# ВРЕМЕННО, пока на сервере нет SMTP: без него ссылка для входа печатается
# в журнал приложения, и читать её оттуда неудобно. С ним владелец открывает
# /dev-login и попадает в свою комнату одним действием — без ключа и без
# формы. Второй адрес — /dev-login?fresh=1 — тем же движением СТИРАЕТ комнату
# владельца целиком (вещи, брони, сводки, связи, фото) и ведёт на онбординг
# заново. Необратимо; трогает только комнату QUICK_LOGIN_EMAIL.
#
# ЭТО ОТКРЫТАЯ ДВЕРЬ: кто знает адрес — тот войдёт в комнату владельца.
# Единственный рубильник — QUICK_LOGIN_ENABLED. Пусто или false → маршрута
# нет вовсе: 404 на /dev-login и на все его параметры.
#
# Почта — ровно одна, параметры запроса на неё не влияют.
# КЛЮЧ НЕОБЯЗАТЕЛЕН (тикет 31): пусто — вход открыт. Заполнен (24+ символа) —
# старая ссылка /dev-login?key=… тоже работает, неверный ключ → 404.
# Короче 24 символов за ключ не считается (предупреждение в журнал).
#   openssl rand -hex 24   → QUICK_LOGIN_SECRET
#
# ВЫКЛЮЧИТЬ СРАЗУ, как заработает почта: это обход письма, а не часть продукта.
#
# ТРЕТИЙ АДРЕС — /dev-login?empty=1 (тикет 190): вход ВТОРЫМ пользователем
# стенда, у которого комната заведомо пустая. Он ничего не сеет и ничего не
# стирает; нужен, чтобы смотреть первый экран новичка, не снося стенд. Почта —
# из QUICK_LOGIN_EMPTY_EMAIL, и она тоже только отсюда. Пусто → адреса нет.
QUICK_LOGIN_ENABLED=false
QUICK_LOGIN_SECRET=
QUICK_LOGIN_EMAIL=
QUICK_LOGIN_EMPTY_EMAIL=empty@wishlist.local

# ══ Вторая фаза, пока пусто ═════════════════════════════════════════════
ANTHROPIC_API_KEY=
ADMITAD_TOKEN=
EPN_KEY=
AMAZON_PAAPI_KEY=

# ══ Наблюдаемость (необязательно) ═══════════════════════════════════════
SENTRY_DSN=
POSTHOG_KEY=

# ══ Служебное ═══════════════════════════════════════════════════════════
# Порты, которые Caddy занимает на сервере. Менять незачем — они здесь
# только чтобы можно было поднять такой же стек на другой машине рядом.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
